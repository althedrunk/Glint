<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Glint.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Glint"
    xmlns:chat="using:Glint.Chat"
    Title="Glint">

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style x:Key="TabAudioButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="AllowFocusOnInteraction" Value="False" />
            </Style>

            <DataTemplate x:Key="ChannelExpanded" x:DataType="local:ChannelEntry">
                <Grid Padding="{x:Bind RowPadding, Mode=OneWay}" ColumnSpacing="10" Background="Transparent"
                      Opacity="{x:Bind ItemOpacity, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="{x:Bind AvatarSize, Mode=OneWay}" Height="{x:Bind AvatarSize, Mode=OneWay}" CornerRadius="{x:Bind AvatarRadius, Mode=OneWay}" Background="#26FFFFFF">
                        <Border CornerRadius="{x:Bind AvatarRadius, Mode=OneWay}">
                            <Border.Background>
                                <ImageBrush ImageSource="{x:Bind Avatar, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" FontSize="12" Foreground="{StaticResource GlintSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                Visibility="{x:Bind LiveVisibility, Mode=OneWay}">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource GlintLiveBrush}" />
                        <TextBlock Text="{x:Bind ViewersText, Mode=OneWay}" FontSize="12" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ChannelCompact" x:DataType="local:ChannelEntry">
                <Grid Width="36" Height="40" Background="Transparent"
                      Opacity="{x:Bind ItemOpacity, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                    <Border Width="34" Height="34" CornerRadius="17" Background="#26FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border CornerRadius="17">
                            <Border.Background>
                                <ImageBrush ImageSource="{x:Bind Avatar, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Border>
                    <Ellipse Width="11" Height="11" Fill="{StaticResource GlintLiveBrush}" Stroke="#FF1C1C21" StrokeThickness="2"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,3"
                             Visibility="{x:Bind LiveVisibility, Mode=OneWay}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="VodTemplate" x:DataType="local:VodItem">
                <StackPanel Width="256" Spacing="6" Padding="0,0,0,8">
                    <Grid CornerRadius="6" Background="#FF26262C" Height="144">
                        <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                        <Border Background="#CC000000" CornerRadius="4" Padding="5,1" Margin="6"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <TextBlock Text="{x:Bind Length}" FontSize="12" Foreground="White" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Meta}" FontSize="12" Foreground="{StaticResource GlintSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="StreamCardTemplate" x:DataType="local:StreamCard">
                <StackPanel Spacing="8" Padding="0,0,0,10" Opacity="{x:Bind CardOpacity}">
                    <!-- Viewbox keeps the thumbnail 16:9 as cards stretch to fill the row -->
                    <Viewbox Stretch="Uniform">
                    <Grid CornerRadius="8" Background="#FF26262C" Width="292" Height="164">
                        <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                        <Border Background="{StaticResource GlintLiveBrush}" CornerRadius="4" Padding="5,1" Margin="8"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{x:Bind LiveVisibility}">
                            <TextBlock Text="LIVE" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <Border Background="#CC000000" CornerRadius="4" Padding="6,1" Margin="8"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="{x:Bind LiveVisibility}">
                            <TextBlock Text="{x:Bind ViewersText}" FontSize="12" Foreground="White" />
                        </Border>
                    </Grid>
                    </Viewbox>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" Background="#26FFFFFF" VerticalAlignment="Top">
                            <Border CornerRadius="16">
                                <Border.Background>
                                    <ImageBrush ImageSource="{x:Bind Avatar}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind DisplayName}" FontSize="12.5" Foreground="{StaticResource GlintSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Game}" FontSize="12.5" Foreground="{StaticResource GlintSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="CategoryCardTemplate" x:DataType="local:CategoryCard">
                <StackPanel Width="150" Spacing="6" Padding="0,0,0,10">
                    <Grid CornerRadius="8" Background="#FF26262C" Height="200">
                        <Image Source="{x:Bind BoxArt}" Stretch="UniformToFill" />
                    </Grid>
                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewersText}" FontSize="12" Foreground="{StaticResource GlintSubtleTextBrush}" />
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- title bar: tabs live here, DragRegion is the empty space after them -->
        <Grid x:Name="TitleBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionInset" Width="140" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="BrandPanel" Orientation="Horizontal" Spacing="8" Padding="6,0,10,0" VerticalAlignment="Center">
                <Button x:Name="SidebarToggle" AutomationProperties.Name="Toggle sidebar" Style="{StaticResource IconButton}" Content="&#xE700;"
                        ToolTipService.ToolTip="Sidebar" />
                <Image x:Name="BrandLogo" Width="20" Height="20" />
                <TextBlock Text="Glint" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
            <TabView x:Name="Tabs" Grid.Column="1" VerticalAlignment="Bottom" Margin="4,0,0,0"
                     IsAddTabButtonVisible="True" TabWidthMode="Equal" CanReorderTabs="True" CanDragTabs="True"
                     CloseButtonOverlayMode="OnPointerOver">
                <TabView.Resources>
                    <x:Double x:Key="TabViewItemMaxWidth">220</x:Double>
                    <x:Double x:Key="TabViewItemMinWidth">120</x:Double>
                </TabView.Resources>
                <TabView.TabStripFooter>
                    <Grid x:Name="DragRegion" Background="Transparent" MinWidth="64" />
                </TabView.TabStripFooter>
            </TabView>
            <StackPanel x:Name="TitleActions" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            </StackPanel>
        </Grid>

        <Grid x:Name="Body" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="244" />
                <ColumnDefinition x:Name="MainCol" Width="*" />
                <ColumnDefinition x:Name="SplitterCol" Width="5" />
                <ColumnDefinition x:Name="ChatCol" Width="360" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="Sidebar" Padding="8,2,6,8" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="6">
                <Button x:Name="SidebarBrowseButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="10,7" CornerRadius="6"
                        AutomationProperties.Name="Browse" ToolTipService.ToolTip="Browse live channels and categories (Ctrl+B)">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE774;" FontSize="16" />
                        <TextBlock x:Name="SidebarBrowseText" Text="Browse" FontSize="13.5" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <TextBox x:Name="AddBox" PlaceholderText="Add a channel" />
                <Button x:Name="AddCompactButton" AutomationProperties.Name="Add a channel" Style="{StaticResource IconButton}" Content="&#xE710;" Visibility="Collapsed"
                        HorizontalAlignment="Center" ToolTipService.ToolTip="Add a channel">
                    <Button.Flyout>
                        <Flyout x:Name="AddFlyout" Placement="RightEdgeAlignedTop">
                            <TextBox x:Name="AddBoxCompact" Width="220" PlaceholderText="Channel name or link" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                </StackPanel>
                <TextBlock x:Name="SidebarHeader" Grid.Row="1" Text="CHANNELS" FontSize="11" FontWeight="SemiBold"
                           CharacterSpacing="60" Foreground="{StaticResource GlintSubtleTextBrush}" Margin="4,6,0,0" />
                <ListView x:Name="ChannelList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True"
                          ItemTemplate="{StaticResource ChannelExpanded}" Padding="0" Margin="-4,0,-4,0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Padding" Value="6,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <TextBlock x:Name="SidebarEmpty" Grid.Row="2" TextWrapping="Wrap" FontSize="12.5" Margin="4,4,4,0"
                           Foreground="{StaticResource GlintSubtleTextBrush}"
                           Text="Nothing here yet. Add a channel above, or log in to pull in the people you follow." />
                <Grid x:Name="SidebarFooter" Grid.Row="3" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AccountButton" AutomationProperties.Name="Account" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE77B;" FontSize="15" />
                            <TextBlock x:Name="AccountText" Text="Log in" FontSize="13" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" AutomationProperties.Name="Settings" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE713;"
                            ToolTipService.ToolTip="Settings" />
                </Grid>
            </Grid>

            <Grid x:Name="MainArea" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- mpv's native window sits on top of this, so anything drawn here only shows while it's hidden -->
                <Grid x:Name="VideoArea" Background="Black" CornerRadius="8,0,0,0">
                    <StackPanel x:Name="VideoStatus" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                        <ProgressRing x:Name="VideoSpinner" Width="40" Height="40" IsActive="False" />
                        <Border x:Name="OfflineAvatar" Width="88" Height="88" CornerRadius="44" Visibility="Collapsed" Opacity="0.85">
                            <Border.Background>
                                <ImageBrush x:Name="OfflineAvatarBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="VideoStatusText" HorizontalAlignment="Center" FontSize="15"
                                   Foreground="{StaticResource GlintSubtleTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button x:Name="RetryButton" AutomationProperties.Name="Retry" Content="Try again" Visibility="Collapsed" />
                            <Button x:Name="OfflineVodsButton" AutomationProperties.Name="Past broadcasts" Content="Past broadcasts" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>


                </Grid>

                <Grid x:Name="InfoBar" Grid.Row="1" Padding="14,10,10,10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="44" Height="44">
                        <Ellipse x:Name="InfoLiveRing" Stroke="{StaticResource GlintLiveBrush}" StrokeThickness="2" Visibility="Collapsed" />
                        <Border Width="38" Height="38" CornerRadius="19" Background="#26FFFFFF">
                            <Border CornerRadius="19">
                                <Border.Background>
                                    <ImageBrush x:Name="InfoAvatar" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="InfoName" FontWeight="SemiBold" FontSize="15" />
                            <Border x:Name="LiveBadge" Background="{StaticResource GlintLiveBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <Border x:Name="VodBadge" Background="#FF3A3A44" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="VOD" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="InfoTitle" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="InfoMeta" FontSize="12" Foreground="{StaticResource GlintSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="GoLiveButton" AutomationProperties.Name="Back to live" Content="Back to live" Visibility="Collapsed" Margin="0,0,6,0" />
                        <Button x:Name="VideosButton" AutomationProperties.Name="Past broadcasts" Style="{StaticResource IconButton}" Content="&#xE81C;"
                                ToolTipService.ToolTip="Past broadcasts" />
                        <Button x:Name="ChatOnlyButton" AutomationProperties.Name="Chat only" Style="{StaticResource IconButton}" Content="&#xE8A0;"
                                ToolTipService.ToolTip="Hide video (chat only)" />
                        <Button x:Name="MultiviewButton" AutomationProperties.Name="Multiview" Style="{StaticResource IconButton}" Content="&#xE8A9;"
                                ToolTipService.ToolTip="Multiview (Ctrl+Shift+M)" />
                    </StackPanel>
                </Grid>
            </Grid>

            <local:GripSplitter x:Name="Splitter" Grid.Column="2" Background="Transparent">
                <Rectangle Width="1" HorizontalAlignment="Right" Fill="{StaticResource GlintPanelBorderBrush}" />
            </local:GripSplitter>

            <Grid x:Name="ChatPanel" Grid.Column="3" Background="{StaticResource GlintPanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Padding="14,8,6,8" BorderBrush="{StaticResource GlintPanelBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#FF6B6B76" />
                        <TextBlock x:Name="ChatHeader" Text="Chat" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                    <Grid x:Name="ChatActionsHost" Grid.Column="1">
                        <StackPanel x:Name="ChatHeaderActions" Orientation="Horizontal" Spacing="2">
                            <Button x:Name="MentionsButton" Style="{StaticResource IconButton}" Width="30" Height="28"
                                    AutomationProperties.Name="Mentions" ToolTipService.ToolTip="Mentions history">
                                <Grid>
                                    <TextBlock Text="@" FontFamily="Segoe UI Variable Text" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <Border x:Name="MentionsBadge" Background="{StaticResource GlintLiveBrush}" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-9,0" Visibility="Collapsed">
                                        <TextBlock x:Name="MentionsCount" FontFamily="Segoe UI Variable Text" FontSize="9.5" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Button x:Name="IgnoreWordsButton" Style="{StaticResource IconButton}" Width="30" Height="28" Content="&#xE71C;"
                                    AutomationProperties.Name="Ignored words settings" ToolTipService.ToolTip="Ignored words" />
                        </StackPanel>
                    </Grid>
                    <Button x:Name="ShowVideoButton" Grid.Column="2" HorizontalAlignment="Right" AutomationProperties.Name="Show video" Style="{StaticResource IconButton}" Content="&#xE714;"
                                ToolTipService.ToolTip="Show video" Visibility="Collapsed" Height="28" />
                </Grid>
                <chat:ChatView x:Name="Chat" Grid.Row="1" />
                <Grid x:Name="ChatInputHost" Grid.Row="2" Padding="10,6,10,10">
                    <!-- moved as one piece between here and the multiview composer -->
                    <Grid x:Name="Composer" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="ReplyBar" Visibility="Collapsed" Background="#1AFFFFFF" CornerRadius="6" Padding="10,2,2,2" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ReplyBarText" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Foreground="{StaticResource GlintSubtleTextBrush}" />
                            <Button x:Name="ReplyBarClose" Grid.Column="1" Style="{StaticResource IconButton}" Width="26" Height="24" FontSize="10"
                                    Content="&#xE711;" AutomationProperties.Name="Cancel reply" ToolTipService.ToolTip="Cancel reply (Esc)" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChatInput" PlaceholderText="Send a message" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="False" />
                            <Button x:Name="EmoteButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE76E;" VerticalAlignment="Bottom"
                                    AutomationProperties.Name="Emotes" ToolTipService.ToolTip="Emotes" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <UserControl x:Name="MultiviewRoot" Grid.Column="1" Grid.ColumnSpan="3" Visibility="Collapsed" IsTabStop="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="10,6" ColumnSpacing="8" Background="{StaticResource GlintPanelBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ComboBox x:Name="MultiviewCount" Width="108" AutomationProperties.Name="Stream count" />
                            <ComboBox x:Name="MultiviewLayout" Width="128" AutomationProperties.Name="Video layout" />
                            <Button x:Name="MultiviewOptions" Style="{StaticResource IconButton}" Content="&#xE713;" AutomationProperties.Name="Multiview options" ToolTipService.ToolTip="Chat and layout options">
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel Width="270" Spacing="12">
                                            <ComboBox x:Name="MultiviewChatMode" Header="Chats" HorizontalAlignment="Stretch" AutomationProperties.Name="Multiview chats" />
                                            <ComboBox x:Name="MultiviewDock" Header="Chat position" HorizontalAlignment="Stretch" AutomationProperties.Name="Chat position" />
                                            <Button x:Name="MultiviewPins" Content="Choose pinned chats" HorizontalAlignment="Stretch" AutomationProperties.Name="Choose pinned chats" />
                                            <Slider x:Name="MultiviewChatWidth" Header="Chat width" Minimum="260" Maximum="600" StepFrequency="10" AutomationProperties.Name="Multiview chat width" />
                                            <Slider x:Name="MultiviewChatHeight" Header="Chat height" Minimum="140" Maximum="700" StepFrequency="10" AutomationProperties.Name="Multiview chat height" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="MultiviewAdd" Style="{StaticResource IconButton}" Content="&#xE710;" AutomationProperties.Name="Add multiview channel" ToolTipService.ToolTip="Add a channel">
                                <Button.Flyout>
                                    <Flyout x:Name="MultiviewAddFlyout">
                                        <TextBox x:Name="MultiviewAddBox" Width="240" PlaceholderText="Channel name or link" AutomationProperties.Name="Multiview channel name" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="MultiviewRestoreGrid" Content="Back to grid" Visibility="Collapsed" AutomationProperties.Name="Back to grid" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Grid x:Name="MultiviewChatActionsHost" VerticalAlignment="Center" />
                            <Button x:Name="MultiviewExit" Content="Single view" AutomationProperties.Name="Exit multiview" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="MultiviewContent" Grid.Row="1" Margin="6">
                        <Grid x:Name="MultiviewVideos" RowSpacing="6" ColumnSpacing="6" />
                        <local:GripSplitter x:Name="MultiviewDivider" Background="Transparent" />
                        <Grid x:Name="MultiviewChatDock" RowSpacing="6" ColumnSpacing="6" />
                    </Grid>
                    <Grid Grid.Row="2" Padding="10,4,10,10" ColumnSpacing="10" Background="{StaticResource GlintPanelBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="MultiviewRecipient" Header="Send to" HorizontalAlignment="Stretch" AutomationProperties.Name="Message recipient" />
                        <Grid x:Name="MultiviewComposerInput" Grid.Column="1" VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>
            </UserControl>

            <Grid x:Name="VodPanel" Grid.Column="1" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#FF0F0F12" Padding="22,16,10,0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="VodPanelTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="VodPanelClose" AutomationProperties.Name="Close videos" Style="{StaticResource IconButton}" Content="&#xE711;"
                            HorizontalAlignment="Right" ToolTipService.ToolTip="Back" />
                </Grid>
                <GridView x:Name="VodGrid" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                          ItemTemplate="{StaticResource VodTemplate}" />
                <ProgressRing x:Name="VodSpinner" Grid.Row="1" Width="36" Height="36" IsActive="False" />
                <TextBlock x:Name="VodEmpty" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource GlintSubtleTextBrush}" Text="No past broadcasts. Some streamers keep them private." />
            </Grid>

            <Grid x:Name="EmptyState" Grid.Column="1" Grid.ColumnSpan="3" Background="#80101014" CornerRadius="8,0,0,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="340">
                    <Image x:Name="EmptyLogo" Width="80" Height="80" Margin="0,0,0,6" />
                    <TextBlock Text="What are we watching?" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Choose a stream from the sidebar, browse, or enter a channel." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource GlintSubtleTextBrush}" />
                    <TextBox x:Name="EmptyAddBox" PlaceholderText="Channel name or twitch.tv link" Margin="0,4,0,0" />
                    <Button x:Name="EmptyBrowseButton" Content="Browse live channels" HorizontalAlignment="Center" />
                    <TextBlock Text="Ctrl+T new tab, Ctrl+W close tab"
                               FontSize="12" TextAlignment="Center" Foreground="{StaticResource GlintSubtleTextBrush}" Opacity="0.8" />
                </StackPanel>
            </Grid>

            <Grid x:Name="BrowsePage" Grid.Column="1" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#FF0F0F12" Padding="24,14,8,0" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="14" Padding="0,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="BrowseBack" Style="{StaticResource IconButton}" Content="&#xE72B;" Visibility="Collapsed"
                                AutomationProperties.Name="Back to categories" ToolTipService.ToolTip="Back" />
                        <TextBlock x:Name="BrowseTitle" Text="Browse" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="BrowseModes" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="12,2,0,0">
                        <ToggleButton x:Name="BrowseLiveMode" Content="Live channels" IsChecked="True" CornerRadius="16" Padding="14,4" />
                        <ToggleButton x:Name="BrowseCategoriesMode" Content="Categories" CornerRadius="16" Padding="14,4" />
                    </StackPanel>
                    <TextBox x:Name="BrowseSearch" Grid.Column="3" Width="260" VerticalAlignment="Center"
                             PlaceholderText="Search channels and categories" AutomationProperties.Name="Search" />
                    <Button x:Name="BrowseClose" Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE711;"
                            AutomationProperties.Name="Close browse" ToolTipService.ToolTip="Close (Esc)" />
                </Grid>
                <Grid Grid.Row="1" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="BrowseCategoriesHeader" Text="CATEGORIES" Visibility="Collapsed" FontSize="11" FontWeight="SemiBold"
                               CharacterSpacing="60" Foreground="{StaticResource GlintSubtleTextBrush}" />
                    <ListView x:Name="BrowseCategoryStrip" Grid.Row="1" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True" Height="262"
                              ItemTemplate="{StaticResource CategoryCardTemplate}" ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                    <TextBlock x:Name="BrowseChannelsHeader" Grid.Row="2" Text="CHANNELS" Visibility="Collapsed" FontSize="11" FontWeight="SemiBold"
                               CharacterSpacing="60" Foreground="{StaticResource GlintSubtleTextBrush}" />
                    <GridView x:Name="BrowseGrid" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="True"
                              ItemTemplate="{StaticResource StreamCardTemplate}" />
                    <TextBlock x:Name="BrowseEmpty" Grid.Row="3" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource GlintSubtleTextBrush}" />
                </Grid>
                <ProgressRing x:Name="BrowseSpinner" Grid.Row="1" Width="36" Height="36" IsActive="False" />
            </Grid>
        </Grid>
    </Grid>
</Window>

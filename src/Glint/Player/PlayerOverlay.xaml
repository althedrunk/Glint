<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Glint.Player.PlayerOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:Glint.Player"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" RequestedTheme="Dark">
        <Grid.Resources>
            <Style x:Key="OverlayButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="AllowFocusOnInteraction" Value="False" />
                <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="18" />
            </Style>
            <Style TargetType="Slider">
                <Setter Property="AllowFocusOnInteraction" Value="False" />
            </Style>
            <Style x:Key="OverlayTextButton" TargetType="Button" BasedOn="{StaticResource OverlayButton}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </Grid.Resources>

        <!-- the gradient is what makes white controls readable on a bright frame -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00000000" />
                <GradientStop Offset="0.45" Color="#66000000" />
                <GradientStop Offset="1" Color="#D9000000" />
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel VerticalAlignment="Bottom" Padding="14,0,10,8" Spacing="2">
            <Border x:Name="ClipToast" x:FieldModifier="internal" Visibility="Collapsed" HorizontalAlignment="Right" Margin="0,0,4,6"
                    Background="#F21E1E24" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,6,6,6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="ClipSpinner" x:FieldModifier="internal" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                    <TextBlock x:Name="ClipToastText" x:FieldModifier="internal" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                    <Button x:Name="ClipEditButton" x:FieldModifier="internal" Content="Edit" Visibility="Collapsed" Padding="10,3"
                            AutomationProperties.Name="Edit clip" ToolTipService.ToolTip="Trim and title it on twitch.tv" />
                    <Button x:Name="ClipCopyButton" x:FieldModifier="internal" Content="Copy link" Visibility="Collapsed" Padding="10,3"
                            AutomationProperties.Name="Copy clip link" />
                </StackPanel>
            </Border>
            <StackPanel x:Name="TitlePanel" x:FieldModifier="internal" Visibility="Collapsed" Padding="6,0,0,4">
                <TextBlock x:Name="TitleText" x:FieldModifier="internal" FontSize="16" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleText" x:FieldModifier="internal" FontSize="12.5" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid x:Name="SeekRow" x:FieldModifier="internal" Visibility="Collapsed">
                <Slider x:Name="Seek" x:FieldModifier="internal" Minimum="0" Maximum="1" IsThumbToolTipEnabled="False"
                        Margin="4,0,4,-6" AutomationProperties.Name="Seek" />
                <!-- time under the pointer while hovering the seek bar -->
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="SeekPreview" x:FieldModifier="internal" Background="#E6202026" CornerRadius="4" Padding="6,2"
                            Canvas.Top="-24" Visibility="Collapsed">
                        <TextBlock x:Name="SeekPreviewText" x:FieldModifier="internal" FontSize="12" Foreground="White" />
                    </Border>
                </Canvas>
            </Grid>

            <Grid ColumnSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="PlayPauseButton" x:FieldModifier="internal" Style="{StaticResource OverlayButton}" Content="&#xE769;"
                            AutomationProperties.Name="Play or pause" ToolTipService.ToolTip="Pause (Space)" />
                    <Button x:Name="BackButton" x:FieldModifier="internal" Style="{StaticResource OverlayButton}" Visibility="Collapsed"
                            AutomationProperties.Name="Seek back">
                        <TextBlock x:Name="BackSeconds" x:FieldModifier="internal" Text="-10" FontFamily="Segoe UI Variable Text" FontSize="13" FontWeight="SemiBold" />
                    </Button>
                    <Button x:Name="ForwardButton" x:FieldModifier="internal" Style="{StaticResource OverlayButton}" Visibility="Collapsed"
                            AutomationProperties.Name="Seek forward">
                        <TextBlock x:Name="ForwardSeconds" x:FieldModifier="internal" Text="+10" FontFamily="Segoe UI Variable Text" FontSize="13" FontWeight="SemiBold" />
                    </Button>
                    <Button x:Name="MuteButton" x:FieldModifier="internal" Style="{StaticResource OverlayButton}" Content="&#xE767;"
                            AutomationProperties.Name="Mute" ToolTipService.ToolTip="Mute (M)" />
                    <local:VolumeControl x:Name="VolumeSlider" x:FieldModifier="internal" Width="96" Minimum="0" Maximum="100" StepFrequency="1" AllowFocusOnInteraction="False"
                            VerticalAlignment="Center" Margin="2,0,10,0" AutomationProperties.Name="Volume" />
                    <Border x:Name="LiveBadge" x:FieldModifier="internal" Background="#FFFF4F5E" CornerRadius="4" Padding="6,1"
                            VerticalAlignment="Center" Margin="2,0,8,0">
                        <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="White" />
                    </Border>
                    <Button x:Name="GoLiveButton" x:FieldModifier="internal" Style="{StaticResource OverlayTextButton}" Visibility="Collapsed"
                            AutomationProperties.Name="Back to live" ToolTipService.ToolTip="Back to live">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#FFFF4F5E" VerticalAlignment="Center" />
                            <TextBlock Text="Go live" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="StatusText" x:FieldModifier="internal" Grid.Column="1" Margin="8,0"
                           VerticalAlignment="Center" FontSize="13" Foreground="#E6FFFFFF" TextTrimming="CharacterEllipsis" />

                <StackPanel x:Name="RightControls" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="ClipButton" x:FieldModifier="internal" Style="{StaticResource OverlayButton}" Content="&#xE8C6;"
                            AutomationProperties.Name="Clip" ToolTipService.ToolTip="Clip (Alt+X)" />
                    <Button x:Name="ReloadButton" x:FieldModifier="internal" Style="{StaticResource OverlayButton}" Content="&#xE72C;"
                            AutomationProperties.Name="Reload stream" ToolTipService.ToolTip="Reload (F5)" />
                    <Button x:Name="SpeedButton" x:FieldModifier="internal" Style="{StaticResource OverlayTextButton}" Content="1x" Visibility="Collapsed"
                            AutomationProperties.Name="Playback speed" ToolTipService.ToolTip="Speed" />
                    <Button x:Name="QualityButton" x:FieldModifier="internal" Style="{StaticResource OverlayTextButton}"
                            AutomationProperties.Name="Quality" ToolTipService.ToolTip="Quality">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE713;" FontSize="15" />
                            <TextBlock x:Name="QualityText" x:FieldModifier="internal" Text="Auto" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ChatButton" x:FieldModifier="internal" Style="{StaticResource OverlayButton}" Content="&#xE8BD;"
                            AutomationProperties.Name="Toggle chat" ToolTipService.ToolTip="Chat (C)" />
                    <Button x:Name="MultiviewButton" x:FieldModifier="internal" Style="{StaticResource OverlayButton}" Content="&#xE8A9;"
                            AutomationProperties.Name="Multiview" ToolTipService.ToolTip="Multiview (Ctrl+Shift+M)" />
                    <Button x:Name="TheatreButton" x:FieldModifier="internal" Style="{StaticResource OverlayButton}" Content="&#xE7F4;"
                            AutomationProperties.Name="Theatre mode" ToolTipService.ToolTip="Theatre mode (T)" />
                    <Button x:Name="FullscreenButton" x:FieldModifier="internal" Style="{StaticResource OverlayButton}" Content="&#xE740;"
                            AutomationProperties.Name="Fullscreen" ToolTipService.ToolTip="Fullscreen (F)" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>

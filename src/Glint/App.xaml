<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Glint.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="GlintAccent">#A970FF</Color>
            <Color x:Key="GlintLive">#FF4F5E</Color>
            <SolidColorBrush x:Key="GlintAccentBrush" Color="{StaticResource GlintAccent}" />
            <SolidColorBrush x:Key="GlintLiveBrush" Color="{StaticResource GlintLive}" />
            <SolidColorBrush x:Key="GlintPanelBrush" Color="#B3141418" />
            <SolidColorBrush x:Key="GlintPanelBorderBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="GlintSubtleTextBrush" Color="#A0A0AB" />
            <FontFamily x:Key="GlintFont">Segoe UI Variable Text</FontFamily>

            <!-- Purple accent for selection / toggles -->
            <Color x:Key="SystemAccentColor">#9147FF</Color>
            <Color x:Key="SystemAccentColorLight1">#A970FF</Color>
            <Color x:Key="SystemAccentColorLight2">#BF94FF</Color>
            <Color x:Key="SystemAccentColorLight3">#D1B3FF</Color>
            <Color x:Key="SystemAccentColorDark1">#772CE8</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
